# Server
PORT=8000
LOG_LEVEL=info
DATA_DIR=./data

# LLM (OpenAI-compatible)
# Copy this file to .env and fill values locally. Never commit .env.
LLM_BASE_URL=https://your-provider.example/v1
LLM_API_KEY=your_api_key_here
LLM_MODEL=your_chat_model

# Embedding (optional; defaults to the LLM-compatible gateway)
# EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
# EMBEDDING_API_KEY=your_embedding_api_key_here
EMBEDDING_MODEL=your_embedding_model
EMBEDDING_DIM=1024

# Qdrant (empty URL uses the local embedded mode)
# QDRANT_URL=http://localhost:6333
QDRANT_SUPPLIER_COLLECTION=sourcepilot_suppliers

# Reranker (optional)
# RERANKER_BASE_URL=https://your-reranker.example
# RERANKER_MODEL=your_reranker_model

# Web search (optional)
# TAVILY_API_KEY=your_tavily_api_key_here

# Redis / queue (optional)
# REDIS_URL=redis://localhost:6379/0
# QUEUE_ENABLED=1

# Observability (optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
